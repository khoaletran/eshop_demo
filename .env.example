# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN ESHOP (AI & DATABASE)
# Hướng dẫn: Sao chép file này thành .env và điền các giá trị thực tế
# =====================================================================

# 1. Google Gemini API Key (Dùng cho Vector Embedding & Chatbot RAG)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
# Nếu để demo_key: Hệ thống tự động kích hoạt chế độ Fallback thông minh chạy offline
GEMINI_API_KEY=demo_key

# 2. Cấu hình Cơ sở dữ liệu MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eshop
DB_USERNAME=root
DB_PASSWORD=123456

# 3. Cấu hình Server
SERVER_PORT=8080
